<?xml version="1.0" encoding="UTF-8"?> 
<launch>
  <group ns="synched">
  <node pkg="rovio" type="rovio_node" name="rovio" output="screen">
  <param name="filter_config" value="$(find rovio)/cfg/rovio.info"/>
  <param name="camera0_config" value="$(find rovio)/cfg/euroc_cam0.yaml"/>
  <param name="camera1_config" value="$(find rovio)/cfg/euroc_cam1.yaml"/>
  <remap from="/synched/imu0" to="/senti/senti/imu"/>
  <remap from="/synched/cam0/image_raw" to="/synched/infra1/img_rect_raw"/>
  <remap from="/synched/cam1/image_raw" to="/synched/infra2/img_rect_raw"/>

  </node>
  </group>

  <group ns="unsynched">
  <node pkg="rovio" type="rovio_node" name="rovio" output="screen">
  <param name="filter_config" value="$(find rovio)/cfg/rovio.info"/>
  <param name="camera0_config" value="$(find rovio)/cfg/euroc_cam0.yaml"/>
  <param name="camera1_config" value="$(find rovio)/cfg/euroc_cam1.yaml"/>
  <remap from="/unsynched/imu0" to="/senti/senti/imu"/>
  <remap from="/unsynched/cam0/image_raw" to="/camera/infra1/image_rect_raw"/>
  <remap from="/unsynched/cam1/image_raw" to="/camera/infra2/image_rect_raw"/>
  </node>
  </group>
</launch>
